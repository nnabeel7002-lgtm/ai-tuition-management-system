# Discord Bot Token — get from discord.com/developers
DISCORD_TOKEN=your_discord_bot_token_here

# Supabase — get from supabase.com > Settings > API
SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# n8n webhook base URL
# Local: http://localhost:5678
# Production: https://your-n8n-railway-url.railway.app
N8N_BASE_URL=http://localhost:5678

# Whisper model cache directory
WHISPER_CACHE_DIR=D:\whisper-models