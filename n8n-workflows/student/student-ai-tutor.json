    {
      "parameters": {
        "jsCode": "const input = $input.all()[0].json.body;\nconst lower = (input.content || '').toLowerCase();\n\nconst subjects = ['maths','math','english','science','physics',\n                  'chemistry','biology','history','geography',\n                  'urdu','computer','islamiat'];\nlet subject = '';\nfor (const s of subjects) {\n  if (lower.includes(s)) { subject = s; break; }\n}\n\nreturn [{\n  json: {\n    query:       input.content,\n    mode:        'answer',\n    studentName: input.authorName || 'Student',\n    subject:     subject,\n    grade:       ''\n  }\n}]; "
      },
