    {
      "parameters": {
        "jsCode": "const input       = $input.all()[0].json.body;\nconst rawAnswer   = (input.content || '').trim().toUpperCase();\nconst studentName = input.studentName || input.authorName || 'unknown';\nconst quizId      = input.quizId || null;\nconst isDM        = input.isDM || false;\n\nlet answers = [];\nif (rawAnswer.includes(',')) {\n  answers = rawAnswer.split(',').map(a => a.trim());\n} else if (rawAnswer.includes(' ')) {\n  answers = rawAnswer.split(/\\s+/).map(a => a.trim());\n} else {\n  answers = rawAnswer.split('').filter(c => /[ABCD]/.test(c));\n}\nanswers = answers.filter(a => /^[ABCD]$/.test(a));\n\nif (!answers.length) {\n  return [{ json: {\n    error:       true,\n    reply:       `Please answer with letters only. Example: A B C D A`,\n    studentName: studentName\n  }}];\n}\n\nreturn [{\n  json: {\n    error:        false,\n    studentName:  studentName,\n    rawAnswers:   answers.join(',').toLowerCase(),\n    answerCount:  answers.length,\n    quizId:       quizId,\n    isDM:         isDM\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
