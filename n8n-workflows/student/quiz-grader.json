    {
      "parameters": {
        "jsCode": "const items       = $input.all();\nconst answerData  = $('Parse Answer').item.json;\n\n// Find the most recent active quiz\nconst activeQuizzes = items.filter(i => i.json.Status === 'Active');\n\nif (!activeQuizzes.length) {\n  return [{ json: {\n    error:  true,\n    reply:  `${answerData.studentName}, no active quiz found. Ask your tutor to generate one.`\n  }}];\n}\n\nconst quiz          = activeQuizzes[activeQuizzes.length - 1].json;\nconst correctArr    = quiz.CorrectAnswers.split(',').map(a => a.trim().toLowerCase());\nconst studentArr    = answerData.rawAnswers.split(',').map(a => a.trim().toLowerCase());\nconst questionCount = correctArr.length;\n\nif (studentArr.length !== questionCount) {\n  return [{ json: {\n    error:  true,\n    reply:  `${answerData.studentName}, this quiz has ${questionCount} questions but you gave ${studentArr.length} answers. Please try again with ${questionCount} answers.`\n  }}];\n}\n\n// Grade each answer\nlet correct = 0;\nconst breakdown = [];\nlet questions = [];\ntry { questions = JSON.parse(quiz.Questions); } catch(e) {}\n\ncorrectArr.forEach((correct_ans, i) => {\n  const student_ans = studentArr[i];\n  const isCorrect   = student_ans === correct_ans;\n  if (isCorrect) correct++;\n\n  const q = questions[i] || {};\n  breakdown.push({\n    num:     i + 1,\n    correct: isCorrect,\n    yours:   student_ans.toUpperCase(),\n    answer:  correct_ans.toUpperCase(),\n    question: q.q || `Q${i + 1}`\n  });\n});\n\nconst score      = Math.round((correct / questionCount) * 100);\nconst grade      = score >= 90 ? 'A' : score >= 80 ? 'B' : score >= 70 ? 'C' : score >= 60 ? 'D' : 'F';\nconst emoji      = score >= 75 ? '🎉' : score >= 50 ? '👍' : '📚';\nconst feedback   = score >= 90 ? 'Excellent work!' : score >= 75 ? 'Good job, keep it up!' : score >= 50 ? 'Not bad, but review the missed questions.' : 'Needs more practice. Review the material and try again.';\n\nlet resultMsg = `${emoji} Quiz Results for ${answerData.studentName}\\n`;\nresultMsg    += `Subject: ${quiz.Subject} | Score: ${correct}/${questionCount} (${score}%) | Grade: ${grade}\\n`;\nresultMsg    += '─────────────────────\\n';\n\nbreakdown.forEach(b => {\n  const icon = b.correct ? '✅' : '❌';\n  resultMsg += `${icon} Q${b.num}: You answered ${b.yours}`;\n  if (!b.correct) resultMsg += ` (correct: ${b.answer})`;\n  resultMsg += '\\n';\n});\n\nresultMsg += `─────────────────────\\n${feedback}`;\n\nreturn [{\n  json: {\n    error:          false,\n    quizId:         quiz.QuizID,\n    studentName:    answerData.studentName,\n    subject:        quiz.Subject,\n    score:          score,\n    correct:        correct,\n    questionCount:  questionCount,\n    grade:          grade,\n    studentAnswers: answerData.rawAnswers,\n    resultMsg:      resultMsg\n  }\n}];"
      },
