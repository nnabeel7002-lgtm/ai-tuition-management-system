      "name": "Build Quiz Response"
    },
    {
      "parameters": {
        "jsCode": "const student = $('Verify Student').first().json;\nconst webhook = $('Webhook').first().json.body;\n\nconst quizId = 'QZ' + Date.now().toString().slice(-6);\n\nreturn [{\n  json: {\n    quizId:      quizId,\n    studentName: student.Name.split(' ')[0],\n    studentId:   student.StudentID,\n    grade:       student.Grade || '',\n    subject:     webhook.subject || 'General',\n    query:       `Generate quiz questions about ${webhook.subject || 'General'} for Grade ${student.Grade || 'school'} student`,\n    mode:        'quiz'\n  }\n}];"
      },
