        "specifyBody": "json",
        "jsonBody": "={\n  \"query\": \"{{ $json.query }}\",\n  \"mode\": \"quiz\",\n  \"grade\": \"{{ $json.grade }}\",\n  \"subject\": \"{{ $json.subject }}\",\n  \"studentName\": \"{{ $json.studentName }}\"\n}",
        "options": {}
