      "name": "Call RAG Query"
    },
    {
      "parameters": {
        "jsCode": "const ragResponse = $input.all()[0].json;\nconst quizData    = $('Prepare Quiz RAG').item.json;\n\n// RAG returns the quiz as a string inside reply field\nconst rawQuizText = ragResponse.reply || ragResponse.response || '';\n\nreturn [{\n  json: {\n    response:    rawQuizText,\n    quizId:      quizData.quizId,\n    studentName: quizData.studentName,\n    studentId:   quizData.studentId,\n    subject:     quizData.subject,\n    grade:       quizData.grade\n  }\n}];"
      },
