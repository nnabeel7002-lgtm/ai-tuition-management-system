    {
      "parameters": {
        "jsCode": "const ollamaData = $input.all()[0].json;\nconst promptData = $('Prepare Quiz RAG').item.json;\nlet raw = ollamaData.response || '';\n\nlet questions = [];\ntry {\n  let cleaned = raw\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  // Fix common truncation — Ollama often cuts off before closing brackets\n  if (cleaned.startsWith('{')) {\n    // Count open vs close braces\n    let openBraces    = (cleaned.match(/\\{/g) || []).length;\n    let closeBraces   = (cleaned.match(/\\}/g) || []).length;\n    let openBrackets  = (cleaned.match(/\\[/g) || []).length;\n    let closeBrackets = (cleaned.match(/\\]/g) || []).length;\n\n    // Add missing closing brackets first, then braces\n    const missingBrackets = openBrackets - closeBrackets;\n    const missingBraces   = openBraces   - closeBraces;\n\n    if (missingBrackets > 0) cleaned += ']'.repeat(missingBrackets);\n    if (missingBraces   > 0) cleaned += '}'.repeat(missingBraces);\n  }\n\n  const parsed = JSON.parse(cleaned);\n  questions    = parsed.questions || [];\n\n} catch(e) {\n  // Last resort — extract individual question objects with regex\n  try {\n    const questionMatches = raw.match(/\\{[^{}]*\"q\"[^{}]*\"correct\"[^{}]*\\}/g) || [];\n    questions = questionMatches.map(q => {\n      try { return JSON.parse(q); } catch(e2) { return null; }\n    }).filter(Boolean);\n  } catch(e3) {\n    return [{ json: {\n      error:       true,\n      reply:       'Could not generate quiz. Please try again.',\n      parseError:  e.message,\n      rawResponse: raw.slice(0, 200)\n    }}];\n  }\n}\n\nif (!questions.length || questions.length < 3) {\n  return [{ json: {\n    error:         true,\n    reply:         'Quiz generation incomplete. Please try again.',\n    questionCount: questions.length\n  }}];\n}\n\nquestions = questions.slice(0, 5);\n\n// Validate each question has required fields\nquestions = questions.filter(q => q.q && q.a && q.b && q.c && q.d && q.correct);\n\nif (questions.length < 3) {\n  return [{ json: {\n    error: true,\n    reply: 'Generated questions were incomplete. Please try again.'\n  }}];\n}\n\nlet discordMsg  = `📝 Practice Quiz — ${promptData.subject}\\n`;\ndiscordMsg     += `Quiz ID: ${promptData.quizId}\\n`;\ndiscordMsg     += '─────────────────────\\n\\n';\n\nquestions.forEach((q, i) => {\n  discordMsg += `Q${i + 1}: ${q.q}\\n`;\n  discordMsg += `A) ${q.a}   B) ${q.b}\\n`;\n  discordMsg += `C) ${q.c}   D) ${q.d}\\n\\n`;\n});\n\ndiscordMsg += '─────────────────────\\n';\ndiscordMsg += `${promptData.studentName}, reply with your answers like:\\nA B C D A`;\n\nconst correctAnswers = questions.map(q => q.correct.toLowerCase()).join(',');\nconst questionsJson  = JSON.stringify(questions);\n\nreturn [{\n  json: {\n    error:          false,\n    quizId:         promptData.quizId,\n    studentName:    promptData.studentName,\n    subject:        promptData.subject,\n    discordMsg:     discordMsg,\n    questionsJson:  questionsJson,\n    correctAnswers: correctAnswers,\n    questionCount:  questions.length\n  }\n}];"
      },
