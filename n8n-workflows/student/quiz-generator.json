    {
      "parameters": {
        "jsCode": "const quiz = $('Parse Quiz').item.json;\n\nif (quiz.error) {\n  return [{ json: { reply: quiz.reply, quizId: null, questions: null } }];\n}\n\nreturn [{\n  json: {\n    quizId:    quiz.quizId,\n    questions: quiz.discordMsg,\n    subject:   quiz.subject\n  }\n}];"
      },
