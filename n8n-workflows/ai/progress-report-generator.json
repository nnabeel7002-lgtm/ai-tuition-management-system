        "jsCode": "const input = $input.all()[0].json;\n\n// Check if triggered by schedule (no body) or webhook\nconst isScheduled  = !input.body;\nconst studentName  = isScheduled ? 'all' : (input.body?.studentName || 'all');\nconst today        = new Date().toISOString().split('T')[0];\n\nreturn [{\n  json: {\n    studentName: studentName,\n    today:       today,\n    fetchAll:    studentName.toLowerCase() === 'all',\n    isScheduled: isScheduled\n  }\n}];"
