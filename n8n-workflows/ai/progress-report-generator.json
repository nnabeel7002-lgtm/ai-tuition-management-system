    {
      "parameters": {
        "jsCode": "const student      = $('Loop Over Items').item.json;\nconst attendance   = $('Get Attendance').all();\nconst fees         = $('Get Fees').all();\nconst homework     = $('Get Homework').all();\n\n// Attendance stats\nconst attTotal   = attendance.length;\nconst attPresent = attendance.filter(r => (r.json.Status||'').toLowerCase() === 'present').length;\nconst attAbsent  = attendance.filter(r => (r.json.Status||'').toLowerCase() === 'absent').length;\nconst attLate    = attendance.filter(r => (r.json.Status||'').toLowerCase() === 'late').length;\nconst attPct     = attTotal > 0 ? Math.round(((attPresent + attLate * 0.5) / attTotal) * 100) : 0;\n\n// Fee stats\nconst latestFee     = fees.length ? fees[fees.length - 1].json : null;\nconst feeStatus     = latestFee ? latestFee.Status : 'No records';\nconst feeAmountDue  = latestFee ? latestFee.AmountDue : 0;\nconst feeAmountPaid = latestFee ? latestFee.AmountPaid : 0;\n\n// Homework stats\nconst hwTotal     = homework.length;\nconst hwSubmitted = homework.filter(r => (r.json.Status||'').toLowerCase() === 'submitted').length;\nconst hwPending   = homework.filter(r => (r.json.Status||'').toLowerCase() !== 'submitted').length;\nconst hwPct       = hwTotal > 0 ? Math.round((hwSubmitted / hwTotal) * 100) : 0;\n\nconst pendingList = homework\n  .filter(r => (r.json.Status||'').toLowerCase() !== 'submitted')\n  .map(r => `${r.json.Subject}: ${r.json.Description} (Due: ${(r.json.DueDate||'').split('T')[0]})`)\n  .join(', ');\n\nconst now = new Date();\nconst months = ['January','February','March','April','May','June',\n                'July','August','September','October','November','December'];\n\nreturn [{\n  json: {\n    studentName:    student.Name,\n    firstName:      student.Name.split(' ')[0],\n    grade:          student.Grade,\n    parentName:     student.ParentName,\n    parentDiscordId: student.ParentDiscordID || '',\n    enrollmentDate: student.EnrollmentDate,\n    reportMonth:    months[now.getMonth()] + ' ' + now.getFullYear(),\n    today:          now.toISOString().split('T')[0],\n    attTotal, attPresent, attAbsent, attLate, attPct,\n    feeStatus, feeAmountDue, feeAmountPaid,\n    hwTotal, hwSubmitted, hwPending, hwPct,\n    pendingHomework: pendingList || 'None',\n    attEmoji:  attPct >= 75 ? '✅' : attPct >= 60 ? '⚠️' : '🔴',\n    feeEmoji:  feeStatus === 'Paid' ? '✅' : feeStatus === 'Partial' ? '⚠️' : '🔴',\n    hwEmoji:   hwPct >= 75 ? '✅' : hwPct >= 60 ? '⚠️' : '🔴'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
