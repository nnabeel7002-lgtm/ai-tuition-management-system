    {
      "parameters": {
        "jsCode": "const ollamaData  = $input.all()[0].json;\nconst studentData = $('Build Report Prompt').item.json;\nconst aiReport    = (ollamaData.response || 'Report generation failed.').trim();\n\nconst docTitle = `Progress Report — ${studentData.studentName} — ${studentData.reportMonth}`;\n\nconst docContent = `MONTHLY PROGRESS REPORT\n${studentData.reportMonth}\n\nStudent: ${studentData.studentName}\nGrade: ${studentData.grade}\nParent: ${studentData.parentName}\nDate: ${studentData.today}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nPERFORMANCE SUMMARY\n\n${aiReport}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nSTATISTICS AT A GLANCE\n\nAttendance\n  Total Sessions: ${studentData.attTotal}\n  Present: ${studentData.attPresent}\n  Absent: ${studentData.attAbsent}\n  Late: ${studentData.attLate}\n  Overall Rate: ${studentData.attPct}% ${studentData.attEmoji}\n\nHomework\n  Total Assigned: ${studentData.hwTotal}\n  Submitted: ${studentData.hwSubmitted}\n  Pending: ${studentData.hwPending}\n  Completion Rate: ${studentData.hwPct}% ${studentData.hwEmoji}\n  Pending Tasks: ${studentData.pendingHomework}\n\nFees\n  Status: ${studentData.feeStatus} ${studentData.feeEmoji}\n  Amount Due: PKR ${studentData.feeAmountDue}\n  Amount Paid: PKR ${studentData.feeAmountPaid}\n\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n\nThis report was generated automatically by the Tuition Management System.`;\n\nreturn [{\n  json: {\n    docTitle:        docTitle,\n    docContent:      docContent,\n    studentName:     studentData.studentName,\n    parentName:      studentData.parentName,\n    parentDiscordId: studentData.parentDiscordId,\n    reportMonth:     studentData.reportMonth\n  }\n}];"
      },
