    {
      "parameters": {
        "jsCode": "const s = $input.all()[0].json;\n\nconst prompt = `You are a professional tutor writing a monthly progress report for a student's parents. Write a warm, encouraging, and honest 3-paragraph report.\n\nStudent: ${s.studentName}\nGrade: ${s.grade}\nReport Month: ${s.reportMonth}\n\nData:\n- Attendance: ${s.attPct}% (${s.attPresent} present, ${s.attAbsent} absent, ${s.attLate} late out of ${s.attTotal} sessions)\n- Homework completion: ${s.hwPct}% (${s.hwSubmitted} of ${s.hwTotal} submitted)\n- Pending homework: ${s.pendingHomework}\n- Fee status: ${s.feeStatus}\n\nWrite exactly 3 paragraphs:\nParagraph 1: Overall performance summary — be specific about attendance and homework numbers.\nParagraph 2: Strengths observed this month and areas that need improvement. Be honest but encouraging.\nParagraph 3: Specific recommendations for next month. End with a positive note.\n\nDo not include greetings, subject lines, or sign-offs. Just the 3 paragraphs.`;\n\nreturn [{\n  json: {\n    ...s,\n    ollamaBody: JSON.stringify({\n      model:  'llama3.2:1b',\n      prompt: prompt,\n      stream: false\n    })\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2672,
        -112
      ],
      "id": "768fa44e-5759-4174-86d0-0c86bd77c63e",
