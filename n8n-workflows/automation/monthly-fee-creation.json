    {
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length || !items[0].json.StudentID) {\n  return [{ json: { hasStudents: false } }];\n}\n\nreturn items.map(item => {\n  const student = item.json;\n\n  const now = new Date();\n\n  const months = [\n    'January', 'February', 'March', 'April',\n    'May', 'June', 'July', 'August',\n    'September', 'October', 'November', 'December'\n  ];\n\n  const currentMonth =\n    months[now.getMonth()] + ' ' + now.getFullYear();\n\n  const lastDay =\n    new Date(now.getFullYear(), now.getMonth() + 1, 0);\n\n  const dueDate =\n    lastDay.toISOString().split('T')[0];\n\n  return {\n    json: {\n      hasStudents: true,\n      StudentID: student.StudentID,\n      StudentName: student.Name,\n      FeeAmount: parseFloat(student.FeeAmount) || 0,\n      Month: currentMonth,\n      DueDate: dueDate,\n      AmountPaid: 0,\n      Status: 'Pending'\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        704,
        -128
      ],
      "id": "6c296324-dfc2-4b8b-bc19-c71963db264e",
      "name": "Build Fee Records"
    },
    {
      "parameters": {
        "jsCode": "const student = $('Build Fee Records').item.json;\nconst results = $input.all();\n\nconst alreadyExists = results.some(item =>\n  item.json.StudentID &&\n  item.json.Month\n);\n\nif (alreadyExists) {\n  return [{\n    json: {\n      skip: true,\n      studentId: student.StudentId,\n      studentName: student.StudentName,\n      currentMonth: student.Month,\n      reason: `Fee for ${student.StudentName} for ${student.Month} already exists`\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    skip: false,\n    studentId: student.StudentId,\n    studentName: student.StudentName,\n    feeAmount: student.FeeAmount,\n    currentMonth: student.Month,\n    dueDate: student.DueDate,\n    amountPaid: 0,\n    status: 'Pending'\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
