    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items.length || !items[0].json.HomeworkID) {\n  return [{ json: { hasDue: false } }];\n}\n\nconst tomorrow = new Date();\ntomorrow.setDate(tomorrow.getDate() + 1);\nconst tomorrowStr = tomorrow.toISOString().split('T')[0];\n\nconst dueTomorrow = items.filter(item => {\n  if (!item.json.DueDate) return false;\n  const dueDate = item.json.DueDate.split('T')[0];\n  const status = (item.json.Status || '').toLowerCase();\n  return dueDate === tomorrowStr && status !== 'submitted';\n});\n\nif (!dueTomorrow.length) {\n  return [{ json: { hasDue: false, message: 'No homework due tomorrow.' } }];\n}\n\nreturn dueTomorrow.map(item => ({\n  json: {\n    hasDue:      true,\n    studentName: item.json.StudentName,\n    studentId:   item.json.StudentID,\n    subject:     item.json.Subject,\n    description: item.json.Description,\n    dueDate:     item.json.DueDate.split('T')[0],\n    homeworkId:  item.json.HomeworkID\n  }\n}));"
      },
