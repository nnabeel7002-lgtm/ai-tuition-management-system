    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://discord.com/api/v10/channels/{{ $json.id }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bot YOUR_DISCORD_BOT_TOKEN_HERE"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"content\": \"={{ 'Dear Parent,\\\\n\\\\nThis is a fee reminder for ' + $('Check Pending').item.json.studentName + '.\\\\n\\\\n' + $('Check Pending').item.json.message + '\\\\nMonth: ' + $('Check Pending').item.json.month + '\\\\nDue Date: ' + $('Check Pending').item.json.dueDate + '\\\\n\\\\nPlease arrange payment at your earliest convenience.\\\\nThank you.' }}\"\n}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1344,
        -96
      ],
      "id": "00b30b56-58a8-499b-ac31-95abd6008f41",
      "name": "HTTP Request1"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nif (!items.length || !items[0].json.StudentName) {\n  return [{ json: { \n    hasPending: false,\n    count: 0\n  }}];\n}\n\nconst pending = items.filter(item => \n  item.json.Status === 'Pending' || item.json.Status === 'Partial'\n);\n\nif (!pending.length) {\n  return [{ json: { hasPending: false, count: 0 }}];\n}\n\nreturn pending.map(item => {\n  const amountDue    = parseFloat(item.json.AmountDue) || 0;\n  const amountPaid   = parseFloat(item.json.AmountPaid) || 0;\n  const remaining    = amountDue - amountPaid;\n  const isPartial    = item.json.Status === 'Partial';\n\n  return {\n    json: {\n      hasPending:   true,\n      studentName:  item.json.StudentName,\n      studentId:    item.json.StudentID,\n      amountDue:    amountDue,\n      amountPaid:   amountPaid,\n      remaining:    remaining,\n      month:        item.json.Month,\n      dueDate:      item.json.DueDate,\n      status:       item.json.Status,\n      isPartial:    isPartial,\n      message:      isPartial\n        ? `Partial payment received. Remaining balance: PKR ${remaining} of PKR ${amountDue}.`\n        : `Full fee of PKR ${amountDue} is unpaid.`\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
